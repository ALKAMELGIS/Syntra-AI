SYNTRA_DATA_DIR=./data
SYNTRA_WEIGHTS_DIR=./weights
SYNTRA_TILE_SIZE=1024
SYNTRA_TILE_OVERLAP=0.2
SYNTRA_BATCH_SIZE=4
SYNTRA_NMS_IOU=0.45
# Aerial oriented-box detector for cars, ships, aircraft, oil tanks, bridges.
# A bare name downloads once; a full path works offline. Larger = more accurate:
# yolo11n-obb.pt (fast) < yolo11s-obb.pt < yolo11m-obb.pt
# A .onnx export runs on onnxruntime with no PyTorch needed:
#   yolo export model=yolo11n-obb.pt format=onnx imgsz=1024 opset=17
SYNTRA_AERIAL_OBB_WEIGHTS=yolo11n-obb.pt
SYNTRA_FP16=1
SYNTRA_CPU0_THREADS=4
SYNTRA_CPU1_THREADS=16
SYNTRA_CORS_ORIGINS=http://localhost:5173

# --- Security -----------------------------------------------------------------
# Shared API key. When set, every /api/* call except /api/health must send it
# as the X-API-Key header (or ?api_key=). Leave empty for a single-user local
# install; set it before exposing the server to a network.
SYNTRA_API_KEY=
# Upload size cap in MB (default 20480 = 20 GB).
SYNTRA_MAX_UPLOAD_MB=20480
# Paths sent in API requests (image_path, dataset folders, out_dir) must lie
# inside SYNTRA_DATA_DIR. List extra allowed folders here, separated by ';' on
# Windows or ':' on Linux/macOS.
# SYNTRA_EXTRA_DATA_ROOTS=D:/labelled-data;E:/orthomosaics
# Library Status "Install / Repair / Update" runs pip on the server.
# 1 = allow from anywhere, 0 = never, unset = only from this machine.
# SYNTRA_ALLOW_ENV_ACTIONS=

# --- PROJ data directory override (Windows gotcha) --------------------------
# If you have ANY other GIS tool installed that bundles its own PROJ database
# -- PostgreSQL/PostGIS, QGIS, Anaconda's own GDAL, ArcGIS -- a system-wide
# PROJ_LIB or PROJ_DATA environment variable set by that installer can point
# rasterio/pyproj at an incompatible/older proj.db, causing errors like:
#   CRSError: The EPSG code is unknown. PROJ: ... DATABASE.LAYOUT.VERSION.MINOR
#   = 2 whereas a number >= 6 is expected. It comes from another PROJ installation.
# Confirmed on a real Windows machine with PostgreSQL/PostGIS installed
# (C:\Program Files\PostgreSQL\...\proj\proj.db was shadowing pyproj's own).
# Fix: uncomment and point these at YOUR pyproj install's own data dir --
# find it with:  python -c "import pyproj; print(pyproj.datadir.get_data_dir())"
# PROJ_LIB=C:/Users/you/AppData/Roaming/Python/Python314/site-packages/pyproj/proj_dir/share/proj
# PROJ_DATA=C:/Users/you/AppData/Roaming/Python/Python314/site-packages/pyproj/proj_dir/share/proj
